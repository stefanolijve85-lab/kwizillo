{
  "appId": "com.kwizillo.app",
  "appName": "Kwizillo",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1d5fa8",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "server": {
    "iosScheme": "capacitor"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#1d5fa8",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    }
  },
  "android": {
    "backgroundColor": "#1d5fa8",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  }
}
