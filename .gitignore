# Local secrets / runtime state
.env
.env.*
!.env.example
.tts-cache/
.voice-selection-*.json

# Dependencies / builds
node_modules/
dist/
build/
coverage/

# Capacitor native build output
android/.gradle/
android/app/build/
ios/App/Pods/
ios/App/DerivedData/

# macOS / editors
.DS_Store
.vscode/
.idea/
test-results/
playwright-report/
audio-qa-output/
incoming/
tools/bin/

# Native shells (generated by `npx cap add ios`; the web build it wraps)
www/
ios/App/App/public/
ios/App/build/

# Art masters: the originals the shipped assets are made from (see tools/)
art-source/

# Voice model comparison clips (made by hand, never shipped)
voice-samples/
store/screenshots/

# list of cache files to rsync to the server (tools/speech-inventory.cjs --files)
speech-files.txt
speech-files-new.txt

# Website video (44 MB): lives on the web server, a local copy in site/assets/video/ is not committed
site/assets/video/*.mp4
site/assets/video/*.webm
