# Copy this file to .env and fill in your key. .env is gitignored and the server
# refuses to serve any dot-file over HTTP, so the key stays on this machine.
#
#   cp .env.example .env
#   # then edit .env and paste your key after the = sign
#
# Never paste the key into a chat, a commit message, or a command line: shell
# history and transcripts both keep it.
# Which ElevenLabs model makes the audio. This is what decides how long a child
# waits for a line that has never been spoken before; a line that was spoken
# once is served from .tts-cache in a few milliseconds whatever the model.
# Measured here on 2026-09-27, same sentence, first sound / whole clip:
#   eleven_v3          0.6-1.0 s / 2.0-2.7 s   most expressive, supports [tags]
#   eleven_turbo_v2_5  0.18-0.24 s / 0.29-0.37 s
#   eleven_flash_v2_5  0.13-0.18 s / 0.23-0.31 s   fastest
# ELEVENLABS_MODEL=eleven_v3

ELEVENLABS_API_KEY=

# Optional overrides.
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Pin the voices. Without these the server picks the best match from your library
# each time it starts; with them the choice can never drift. These are the curated
# Kwizillo voices that audio QA on 2026-09-13 resolved to:
# MILO_VOICE_ID_NL=jfwdd64Nlhnj6vcFqRHZ   Kwizillo Milo NL-NL v20  (Netherlands Dutch)
# LUNA_VOICE_ID_NL=SXBL9NbvTrjsJQYay2kT   Kwizillo Luna NL-NL v20  (Netherlands Dutch)
# MILO_VOICE_ID_EN=UgBBYS2sOqTuMpoF3BR0   Kwizillo Milo EN-US v20  (US English)
# LUNA_VOICE_ID_EN=tnSpp4vdxKPjI9w0GnoV   Kwizillo Luna EN-US v20  (US English)

# Production (see deploy/DEPLOY.md). Only set these on the server behind nginx.
# TRUST_PROXY=1
# (capacitor://localhost is the iOS app, https://localhost the Android app)
# ALLOWED_ORIGINS=https://app.kwizillo.nl,https://app.kwizillo.com,capacitor://localhost,https://localhost
# TTS_DAILY_CHARS=300000
# TTS_CACHE_ONLY=1   (never call ElevenLabs; a line missing from .tts-cache gets a 404)
# TTS_RATE_LIMIT=60
