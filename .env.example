# Copy this file to .env and fill in your key. .env is gitignored and the server
# refuses to serve any dot-file over HTTP, so the key stays on this machine.
#
#   cp .env.example .env
#   # then edit .env and paste your key after the = sign
#
# Never paste the key into a chat, a commit message, or a command line: shell
# history and transcripts both keep it.
ELEVENLABS_API_KEY=

# Optional overrides.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# MILO_VOICE_ID_NL=
# LUNA_VOICE_ID_NL=
# MILO_VOICE_ID_EN=
# LUNA_VOICE_ID_EN=
